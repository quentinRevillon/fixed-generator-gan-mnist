# Python
__pycache__/
*.py[cod]

# Environnements virtuels
a2-env/
venv/
.venv/

# Données téléchargées (MNIST)
data/

# Sorties générées
samples/
outputs/

# macOS
.DS_Store

# Tests
.pytest_cache/

# Grilles produites par evaluate.py hors des runs
grid*.png
figures/samples_*.png

# Runs : on versionne le dossier léger (config, métriques, poids last/best de G et D, grille) pour que
# chacun puisse rejouer et évaluer le run ; ckpt/ (34 Mo), TensorBoard et essais Optuna restent locaux.
runs/**
!runs/**/
!runs/**/config.yaml
!runs/**/metrics.jsonl
!runs/**/keep_training.jsonl
!runs/**/G.pth
!runs/**/D.pth
!runs/**/G_best.pth
!runs/**/D_best.pth
!runs/**/grid.png
runs/**/ckpt/**
runs/**/trial_*/**

# Compilation LaTeX (slides/) : seuls les .tex sont versionnés
slides/*.aux
slides/*.log
slides/*.nav
slides/*.out
slides/*.snm
slides/*.toc
slides/*.pdf
